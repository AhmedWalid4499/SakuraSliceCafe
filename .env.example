# Railway sets DATABASE_URL automatically when the Postgres service is
# referenced:  DATABASE_URL = ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:password@localhost:5432/sakura

# Whoever registers with this email becomes the café owner (can use /admin).
ADMIN_EMAIL=you@example.com

# Optional: also forward new letter signups to the Google Sheet the SendGrid
# sender reads from (the old Apps Script web-app URL).
APPS_SCRIPT_URL=

# Set to "production" on Railway so login cookies are marked Secure.
NODE_ENV=production

# The café team's voices (Yuto, Hana, Yuki, Me3temed). Get a key at
# console.anthropic.com → API Keys. Without it, they still answer, but only
# with their few set lines.
ANTHROPIC_API_KEY=
# Only if your key was made at the organisation level rather than inside a
# workspace: the workspace to use (console.anthropic.com → Settings → Workspaces, wrkspc_…)
ANTHROPIC_WORKSPACE_ID=
# Optional: how many messages one guest can send the team per day (default 120)
NPC_DAILY_LIMIT=120
